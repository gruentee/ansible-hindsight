{{ ansible_managed | comment }}
{# Role-managed settings win over hindsight_extra_env. Empty values are omitted. #}
{% set __managed = {
  'HINDSIGHT_API_LLM_PROVIDER': hindsight_llm_provider,
  'HINDSIGHT_API_LLM_MODEL': hindsight_llm_model,
  'HINDSIGHT_API_LLM_API_KEY': hindsight_llm_api_key,
  'HINDSIGHT_API_LLM_BASE_URL': hindsight_llm_base_url,
  'HINDSIGHT_CP_ACCESS_KEY': hindsight_cp_access_key,
  'HINDSIGHT_API_DATABASE_URL': hindsight_database_url,
  'HINDSIGHT_API_WORKER_ID': hindsight_worker_id,
} %}
{% set __env = hindsight_extra_env | combine(__managed | dict2items | rejectattr('value', 'equalto', '') | items2dict) %}
{% for __key in __env | sort %}
{{ __key }}={{ __env[__key] }}
{% endfor %}
